{
  "expo": {
    "name": "Honeysuckle Trail",
    "slug": "mentalheath",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "mentalheath",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.honeysuckleco.honeysuckletrail",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Honeysuckle Trail turns what you say into text so you can talk to the AI companion instead of typing. Your speech is only used to fill in your message.",
        "NSMicrophoneUsageDescription": "Honeysuckle Trail uses the microphone when you tap the mic button in chat, so you can speak your message instead of typing it.",
        "NSCameraUsageDescription": "Honeysuckle Trail uses the camera when you choose to take a new profile photo.",
        "NSPhotoLibraryUsageDescription": "Honeysuckle Trail accesses your photos when you choose a profile picture from your library."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      },
      "entitlements": {
        "aps-environment": "development"
      },
      "appleTeamId": "W94782GT86"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.honeysuckleco.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "googleServicesFile": "./google-services.json"
          },
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAuth",
              "RNFBMessaging"
            ],
            "googleServicesFile": "./GoogleService-Info.plist"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2C1D14",
          "dark": {
            "backgroundColor": "#2C1D14"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "react-native-bottom-tabs",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Honeysuckle Trail uses the microphone when you tap the mic button in chat, so you can speak your message instead of typing it.",
          "speechRecognitionPermission": "Honeysuckle Trail turns what you say into text so you can talk to the AI companion instead of typing. Your speech is only used to fill in your message."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Honeysuckle Trail accesses your photos when you choose a profile picture from your library.",
          "cameraPermission": "Honeysuckle Trail uses the camera when you choose to take a new profile photo.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5032232b-eb7c-4c60-97bd-a2eb73f20d1e"
      }
    }
  }
}
